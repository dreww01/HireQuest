# Django Configuration
SECRET_KEY=your-django-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging Configuration
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# GitHub API (Optional but recommended)
# Get token: https://github.com/settings/tokens
# Create token with scopes: public_repo, read:org
# Without token: 60 requests/hour | With token: 5,000 requests/hour
GITHUB_TOKEN=

# GitHub Search Configuration
GITHUB_SEARCH_KEYWORDS=paid,contract,freelance,hire,bounty
GITHUB_MAX_AGE_DAYS=14

# Hugging Face API (Required for cover letter generation)
# Get API key from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-1B-Instruct

# Telegram Bot (Required for alerts)
# Get token from @BotFather on Telegram
# Get chat ID by messaging your bot, then visiting:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Site URL for dashboard links in Telegram
# Use ngrok/production URL for remote access (e.g., https://yourdomain.com or https://abc123.ngrok.io)
SITE_BASE_URL=http://localhost:8000

# Job Scraping Configuration
SCRAPING_ENABLED=True
SCRAPE_INTERVAL_MINUTES=60
MAX_JOBS_PER_SOURCE=20
JOB_MAX_AGE_DAYS=7

# Job Filtering Keywords
# Comma-separated keywords for filtering scraped jobs
JOB_KEYWORDS=python,django,wordpress,web scraping,automation,backend,api,flask,fastapi,php
